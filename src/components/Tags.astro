---
import type { BlogTag } from '../library/microcms';

type Props = {
  tags: BlogTag[] | undefined;
};

const { tags } = Astro.props;
---

{
  tags && (
    <div class="tags">
      {tags.map((tag) => (
        <span class="tag">{tag.name}</span>
      ))}
    </div>
  )
}
<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .tag {
    background-color: rgb(var(--bg-soft));
    border: 1px solid rgb(var(--gray-light));
    color: rgb(var(--gray));
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
  }
</style>
